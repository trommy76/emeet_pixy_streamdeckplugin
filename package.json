{
  "name": "pixy-streamdeck",
  "version": "1.0.0",
  "private": true,
  "description": "Stream Deck plugin for the EMEET PIXY dual-camera PTZ webcam (tracking, privacy, gesture control, audio mode, auto-privacy).",
  "type": "module",
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --platform=node --format=cjs --target=node18 --external:node-hid --outfile=com.emeetpixy.pixycontrol.sdPlugin/bin/plugin.js --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "build:native": "bash scripts/build-uvc-util.sh",
    "build:native:win": "powershell -ExecutionPolicy Bypass -File scripts/build-uvc-util-win.ps1"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "esbuild": "^0.24.0",
    "node-hid": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "node-hid@3.4.0": true
  }
}
