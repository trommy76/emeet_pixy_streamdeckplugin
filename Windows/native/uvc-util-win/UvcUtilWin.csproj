<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>uvc-util</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>UvcUtilWin</RootNamespace>
    <!-- This whole project is intentionally Windows-only (DirectShow/COM); silence the
         "only supported on windows" platform-compatibility analyzer accordingly. -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

</Project>
